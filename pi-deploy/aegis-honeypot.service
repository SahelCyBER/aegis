[Unit]
Description=AEGIS HTTP Honeypot (Pi edition)
After=network-online.target aegis-firewall.service
Wants=network-online.target

[Service]
Type=simple
User=<USER>
Group=<USER>
WorkingDirectory=/home/<USER>/aegis-honeypot
Environment=HONEYPOT_PORT=8081
Environment=HONEYPOT_LOG=/var/log/aegis/honeypot.log
Environment=AEGIS_LOCAL_FW=http://127.0.0.1:8765
# The env file holds AEGIS_API_URL (e.g. http://<YOUR_SERVER_IP>:8000),
# AEGIS_API_KEY and AEGIS_FIREWALL_SECRET (sent as X-AEGIS-FW-Auth on /block).
# They go in a root-only file, never inline here: unit files are world-readable
# (`systemctl cat`). Create it with:
#   sudo install -m 600 -o root -g root /dev/stdin /etc/aegis/honeypot.env
# AEGIS_LOCAL_FW may also be overridden there to point at a REMOTE firewall
# agent (e.g. a honeypot-only Pi forwarding blocks to the gateway Pi's agent).
EnvironmentFile=-/etc/aegis/honeypot.env
ExecStart=/usr/bin/python3 /home/<USER>/aegis-honeypot/aegis_honeypot.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
